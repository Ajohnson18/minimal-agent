# ── Kai ──────────────────────────────────────────────────────
KAI_VERSION=0.0.1

# ── Required ─────────────────────────────────────────────────
JWT_SECRET=changeme-generate-a-real-secret
POSTGRES_PASSWORD=kai

# ── AI Provider (need at least one key) ──────────────────────
# LLM provider: anthropic | openai | vertex | google
LLM_PROVIDER=anthropic
# Leave LLM_MODEL empty for provider default (anthropic=claude-sonnet, openai=gpt-4o)
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Optional: Vertex AI ──────────────────────────────────────
# VERTEX_AI_PROJECT_ID=
# VERTEX_AI_SERVICE_ACCOUNT_KEY=

# ── Optional: Integrations ───────────────────────────────────
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_APP_TOKEN=
# EXA_API_KEY=
# ELEVENLABS_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000   # set to your self-hosted URL (e.g. http://localhost:5000)

# ── Optional: Ports ──────────────────────────────────────────
# FACE_PORT=3000
# BRAIN_HTTP_PORT=3001
# BRAIN_WS_PORT=18789
