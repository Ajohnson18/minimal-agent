# Database
DATABASE_URL=postgresql://user:password@localhost:5432/somethings

# Vertex AI
VERTEX_AI_PROJECT_ID=your-project-id
VERTEX_AI_LOCATION=us-central1
# Use one of the following for authentication:
# Option 1: Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Option 2: Inline service account JSON (base64 encoded or raw JSON)
# VERTEX_AI_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# API Server
PORT=3001
API_PREFIX=/api/ava
NODE_ENV=development

# Gateway WebSocket Server
GATEWAY_PORT=18789
GATEWAY_PATH=/ws

# Security
JWT_SECRET=your-jwt-secret-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Code Repository Access
CODE_REPOS_BASE_PATH=/Users/arman/Development/Somethings
ALLOWED_REPOS=somethings-api,somethings-reporting,somethings-mentor-dashboard

# Context Management
MAX_CONTEXT_TOKENS=100000
COMPACTION_THRESHOLD=0.8
MAX_MESSAGES_PER_SESSION=500

# SQL Tool Configuration
SQL_QUERY_TIMEOUT_MS=30000
SQL_MAX_ROWS=1000

# Memory System
EMBEDDING_MODEL=text-embedding-004
MEMORY_SEARCH_LIMIT=10
MEMORY_MIN_SCORE=0.7

# Logging
LOG_LEVEL=info

# Browser Sandbox
# local = launch local headless browser (default, may be blocked by some sites)
# sandbox = connect to Docker sandbox via CDP (recommended for anti-detection)
BROWSER_MODE=local
BROWSER_CDP_URL=http://localhost:9222
BROWSER_XVFB_WIDTH=1920
BROWSER_XVFB_HEIGHT=1080
BROWSER_WINDOW_WIDTH=1920
BROWSER_WINDOW_HEIGHT=1080
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080

# Web Search (Exa)
EXA_API_KEY=

# Cursor Cloud Agent API
# Get your API key from https://cursor.com/settings
CURSOR_API_KEY=
