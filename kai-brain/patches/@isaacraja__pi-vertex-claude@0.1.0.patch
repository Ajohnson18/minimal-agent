+// =============================================================================
+// Region Extraction Helpers
+// =============================================================================
+
+/**
+ * Extract region from model baseUrl.
+ * Format: https://us-east5-aiplatform.googleapis.com → us-east5
+ */
+function extractRegionFromBaseUrl(baseUrl?: string): string | undefined {
+	if (!baseUrl) return undefined;
+	try {
+		const url = new URL(baseUrl);
+		// Format: https://<region>-aiplatform.googleapis.com
+		// Extract: <region>
+		const match = url.hostname.match(/^([a-z0-9-]+)-aiplatform\.googleapis\.com$/);
+		return match?.[1];
+	} catch {
+		return undefined;
+	}
+}
