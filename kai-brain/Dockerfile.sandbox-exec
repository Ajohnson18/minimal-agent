# AVA General-Purpose Exec Sandbox
# Persistent container for sandboxed shell execution

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    python3 \
    python3-pip \
    python3-dev \
    ripgrep \
    procps \
    less \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install Python data science packages for python_exec tool
RUN pip3 install --no-cache-dir --break-system-packages \
    pandas \
    numpy \
    matplotlib \
    seaborn \
    scipy \
    scikit-learn \
    requests \
    beautifulsoup4 \
    lxml \
    openpyxl \
    xlrd \
    pyyaml \
    yfinance

# Install Node.js 22
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install mcporter for MCP server access
RUN npm install -g mcporter

RUN useradd --create-home --shell /bin/bash sandbox

# Configure matplotlib for headless mode (as root, then change ownership)
ENV MPLBACKEND=Agg
RUN mkdir -p /home/sandbox/.config/matplotlib && \
    echo "backend: Agg" > /home/sandbox/.config/matplotlib/matplotlibrc && \
    chown -R sandbox:sandbox /home/sandbox/.config

RUN mkdir -p /workspace && chown sandbox:sandbox /workspace

WORKDIR /workspace
USER sandbox

CMD ["sleep", "infinity"]
